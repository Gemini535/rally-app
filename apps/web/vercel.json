{
  "installCommand": "pnpm install",
  "buildCommand": "cd ../.. && pnpm turbo run build --filter=web...",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "functions": { "app/api/[[...route]]/route.ts": { "maxDuration": 30 } },
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/:path*" }]
}
